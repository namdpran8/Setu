<Page
    x:Class="SetuShell.RunningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SetuShell">
    
<Grid>
    <TextBlock x:Name="EmptyStateText" Text="No apps running" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    
    <ListView x:Name="RunningAppsList" Margin="16" SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:RunningAppViewModel">
                <Grid Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,0,0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind PackageName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Orientation="Horizontal" Spacing="16">
                        <StackPanel>
                            <TextBlock Text="PID" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind PidStr}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Uptime" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind UptimeStr}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Grid.Column="2" Content="Force Stop" VerticalAlignment="Center" Click="ForceStop_Click" Tag="{x:Bind PackageName}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Grid>

</Page>
